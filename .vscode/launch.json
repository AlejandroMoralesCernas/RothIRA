{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go Containerized Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote", // not running on my local machine
      "remotePath": "/app",             // Must match container workdir
      "port": 4000,
      "host": "127.0.0.1", // debugger reachable from my machine, docker maps this port to my computer
      "showLog": true, // show debug logs, not required
      "trace": "verbose"
    }
  ]
}